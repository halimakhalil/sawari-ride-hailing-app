# Base URL the browser uses for API calls. Keep "/api" in development (Vite proxies it).
# For a split production deployment set the full backend URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api to (dev only, never bundled).
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Only VITE_* variables are exposed to the browser bundle; never put secrets here.
